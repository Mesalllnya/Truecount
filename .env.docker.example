# TrueCount - konfigurasi Docker Compose
#
# Salin file ini menjadi .env.docker lalu isi nilainya:
#   cp .env.docker.example .env.docker
#
# Jalankan:
#   docker compose --env-file .env.docker up -d --build
#
# JANGAN commit .env.docker (sudah ada di .gitignore).

# ── Port backend di host ─────────────────────────────────
# Frontend/desktop akan memanggil http://IP-SERVER:8000
BACKEND_PORT=8000

# ── Database MySQL (container `db`) ──────────────────────
DB_NAME=truecount_db
DB_USER=truecount
DB_PASS=ganti-password-db-yang-kuat
MYSQL_ROOT_PASSWORD=ganti-password-root-yang-kuat

# ── Aplikasi ─────────────────────────────────────────────
APP_ENV=production
# Origin frontend web (untuk CORS). Contoh LAN: http://192.168.2.102:5173
FRONTEND_ORIGIN=http://localhost:5173

# ── JWT ──────────────────────────────────────────────────
# Buat dengan: php -r "echo bin2hex(random_bytes(48)), PHP_EOL;"
JWT_SECRET=ganti-dengan-string-acak-minimal-64-karakter
JWT_EXPIRE=3600
INVITE_EXPIRE_DAYS=7

# ── Kunci enkripsi (WAJIB 32 byte, di-encode base64) ─────
# Buat dengan: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Harus sama dengan key yang dipakai saat data dienkripsi. Jangan diubah
# setelah ada data, atau foto/pesan lama tidak bisa dibuka.
ENCRYPTION_KEY_B64=GANTI_DENGAN_BASE64_32_BYTE
CHACHA20_KEY_B64=GANTI_DENGAN_BASE64_32_BYTE

# ── Identitas server (opsional) ──────────────────────────
# SERVER_ID dipakai client untuk memastikan terhubung ke server yang benar.
SERVER_ID=
SERVER_LABEL=Docker Demo

# ── Migrasi otomatis saat container start ────────────────
RUN_MIGRATIONS=true
# Seed admin (admin/Admin@1234) + user dev. HANYA untuk demo!
RUN_SEED=false

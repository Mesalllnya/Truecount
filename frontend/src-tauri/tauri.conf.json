{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "TrueCount",
  "version": "0.2.0",
  "identifier": "com.truecount.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "app": {
    "windows": [
      {
        "title": "TrueCount - Secure E-Voting",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "hiddenTitle": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/index.php": "backend/index.php",
      "../../backend/api": "backend/api",
      "../../backend/config": "backend/config",
      "../../backend/helpers": "backend/helpers",
      "../../backend/middleware": "backend/middleware",
      "../../backend/services": "backend/services"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}

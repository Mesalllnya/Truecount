# Salin ke frontend/.env lalu sesuaikan.
# VITE_DEFAULT_SERVER_URL = alamat laptop server di LAN (dipakai saat build
# dan sebagai fallback kalau app_config.json belum ada).
VITE_DEFAULT_SERVER_URL=http://192.168.1.10:8000

# Mode default aplikasi: client | server | standalone
# Kalau tidak diisi: build dev = standalone, build production = client.
# VITE_DEFAULT_MODE=client

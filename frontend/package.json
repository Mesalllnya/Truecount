{
  "name": "truecount",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "php -S localhost:8000 -t ../backend ../backend/index.php",
    "dev:full": "npm run free-ports && concurrently -n php,vite -c red,cyan \"npm:dev:backend\" \"npm:dev\"",
    "free-ports": "powershell -ExecutionPolicy Bypass -File ../scripts/free-ports.ps1",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "axios": "^1.21.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.90.0",
    "terser": "^5.51.2",
    "vite": "^8.3.6"
  }

# TrueCount - Environment Variables
# Salin file ini ke .env dan sesuaikan nilainya.
# JANGAN commit file .env ke repository.

# ── Database ─────────────────────────────────────────────
# Pakai 127.0.0.1, BUKAN localhost: di Windows "localhost" di-resolve ke
# IPv6 (::1) lebih dulu sehingga tiap koneksi MySQL mundur ±2 detik.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=truecount_db
DB_USER=root
DB_PASS=

# ── App ──────────────────────────────────────────────────
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ── JWT ──────────────────────────────────────────────────
# Ganti dengan string acak panjang (min. 32 karakter)
JWT_SECRET=GANTI_DENGAN_SECRET_YANG_KUAT_DAN_PANJANG
JWT_EXPIRE=3600

# ── Undangan pendaftaran ─────────────────────────────────
# Masa berlaku undangan akun (hari)
INVITE_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY_B64=GENERATE_DULU
CHACHA20_KEY_B64=GENERATE_DULU

# ── Identitas server demo ────────────────────────────────
# Dibuat otomatis oleh scripts/deploy-server.ps1
# SERVER_ID dipakai client untuk memastikan terhubung ke server yang benar
SERVER_ID=
SERVER_LABEL=Laptop Demo

# ── Halaman setup server (khusus laptop server) ──────────
# SETUP_PATH=/__tc-setup
# SETUP_TOKEN=<token 32 hex, dibuat script>
# SETUP_ALLOW_REMOTE=false  → hanya bisa dibuka dari 127.0.0.1
SETUP_PATH=/__tc-setup
SETUP_TOKEN=
SETUP_ALLOW_REMOTE=false

# ── WebAuthn (hanya untuk browser di laptop server) ──────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8000
# TrueCount - Environment Variables
# Salin file ini ke .env dan sesuaikan nilainya.
# JANGAN commit file .env ke repository.

# ── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=truecount_db
DB_USER=root
DB_PASS=

# ── App ──────────────────────────────────────────────────
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ── JWT ──────────────────────────────────────────────────
# Ganti dengan string acak panjang (min. 32 karakter)
JWT_SECRET=GANTI_DENGAN_SECRET_YANG_KUAT_DAN_PANJANG
JWT_EXPIRE=3600

# ── Undangan pendaftaran ─────────────────────────────────
# Masa berlaku undangan akun (hari)
INVITE_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY_B64=GENERATE_DULU
CHACHA20_KEY_B64=GENERATE_DULU